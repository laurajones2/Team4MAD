generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feeding {
  id             Int      @id @default(autoincrement())
  method         String
  side           String?     // Only for breast feeding
  duration       Float?      // In minutes
  volume         Float?      // In ml, pumped or bottle/tube
  weightBeforeG  Float?      // Child weight before feeding
  weightAfterG   Float?      // Child weight after feeding
  intakeG        Float?      // Estimated milk intake (g)
  loggedBy       String?     // Display name of the person who logged this
  measuredAt     DateTime
  createdAt      DateTime @default(now())
}

model Diaper {
  id           Int      @id @default(autoincrement())
  wetCount     Int
  dirtyCount   Int
  stoolNotes   String?
  diaperWeight Float?
  loggedBy     String?     // Display name of the person who logged this
  measuredAt   DateTime
  createdAt    DateTime @default(now())
}


model Medication {
  id           Int      @id @default(autoincrement())
  name         String
  dosage       String
  givenAt      DateTime @default(now())
  nextDoseDue  DateTime
}

model Growth {
  id         Int      @id @default(autoincrement())
  weightG    Float    // weight in grams
  loggedBy   String?     // Display name of the person who logged this
  measuredAt DateTime @default(now())
  notes      String?
}

model Vitals {
  id         Int      @id @default(autoincrement())
  temp       Float
  hr         Int
  br         Int
  spo2       Int
  note       String?
  loggedBy   String?     // Display name of the person who logged this
  measuredAt DateTime
  createdAt  DateTime @default(now())
}


model SleepLog {
  id              Int      @id @default(autoincrement())
  sleepDate       DateTime
  durationMinutes Int
  quality         String?
  loggedBy        String?     // Display name of the person who logged this
}


model HealthEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  recordedAt  DateTime @default(now())
  photoUrl    String?  // optional link to image
  videoUrl    String?  // optional link to video
  tags        String[] // e.g., ["seizure", "vomiting"]
}
